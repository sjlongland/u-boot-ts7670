kernel=/zImage
fdtimage=/imx28-ts7670d.dtb
fdtaddr=0x41000000
cmdline_append=ro rootwait console=ttyAMA0,115200
sddevidx=0
sdbootidx=2
sdrootidx=2
emmcdevidx=1
emmcbootidx=2
emmcrootidx=3
bootlinux=if load mmc ${bootdevidx}:${bootpartidx} ${loadaddr} /boot.ub; 
	then
		echo Booting from custom /boot.ub; 
		source ${loadaddr}; 
	fi;
	load mmc ${bootdevidx}:${bootpartidx} ${loadaddr} ${kernel};
	load mmc ${bootdevidx}:${bootpartidx} ${fdtaddr} ${fdtimage};
	setenv bootargs root=/dev/mmcblk${bootdevidx}p${rootpartidx} ${cmdline_append}; 
	bootz ${loadaddr} - ${fdtaddr}; 

emmcboot=echo Booting from the onboard eMMC  ...; 
	setenv bootdevidx ${emmcdevidx};
	setenv bootpartidx ${emmcbootidx};
	setenv rootpartidx ${emmcrootidx};
	run bootlinux;

sdboot=echo Booting from SD  ...; 
	setenv bootdevidx ${sddevidx};
	setenv bootpartidx ${sdbootidx};
	setenv rootpartidx ${sdrootidx};
	run bootlinux;
