if ARCH_MX23

config MX23
	bool
	default y

choice
	prompt "MX23 board select"
	optional

config TARGET_MX23_OLINUXINO
	bool "Support mx23_olinuxino"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_MX23EVK
	bool "Support mx23evk"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

endchoice

config SYS_SOC
	default "mxs"

source "board/olimex/mx23_olinuxino/Kconfig"
source "board/nxp/mx23evk/Kconfig"

endif

if ARCH_MX28

config MX28
	bool
	default y

choice
	prompt "MX28 board select"
	optional

config TARGET_BTT
	bool "Support BTT"
	select PL01X_SERIAL
	imply OF_UPSTREAM

config TARGET_MX28EVK
	bool "Support mx28evk"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7400_V2
	bool "Support TS-7400 v2"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7553
	bool "Support TS-7553 v2"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7670B
	bool "Support TS-7670 rev B"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7670D
	bool "Support TS-7670 rev D"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7680
	bool "Support TS-7680"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_TS7695
	bool "Support TS-7695"
	select PL01X_SERIAL
	select BOARD_EARLY_INIT_F

config TARGET_XEA
	bool "Support XEA"
	select PL01X_SERIAL

endchoice

config SYS_SOC
	default "mxs"

config SPL_MXS_PMU_MINIMAL_VDD5V_CURRENT
	bool "Force minimal current draw from VDD5V by MX28 PMU"
	help
	  After setting this option, the current drawn from VDD5V
	  by the PMU is reduced to zero - the DCDC_BATT is used as
	  the main power source for PMU.

config SPL_MXS_PMU_DISABLE_BATT_CHARGE
	bool "Disable Battery Charging in MX28 PMU"

config SPL_MXS_PMU_ENABLE_4P2_LINEAR_REGULATOR
	bool "Enable the 4P2 linear regulator in MX28 PMU"
	default y
	help
	  This option enables the 4P2 linear regulator (derived
	  from VDD5V) - so the VDD4P2 power source is operational.

source "board/nxp/mx28evk/Kconfig"
source "board/liebherr/btt/Kconfig"
source "board/liebherr/xea/Kconfig"

endif
